{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sick-o-scope",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // No per-version preview links: every version would otherwise stay reachable at its own URL.
  "preview_urls": false,
  // The React SPA (built by Vite into dist/client) is served as static assets
  // without invoking the Worker. Unknown paths fall back to index.html for
  // client-side routing, except /api/*, which always runs the Worker (ADR 0001).
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Created with EU jurisdiction: the data never leaves the EU.
      "database_name": "sick-o-scope-eu",
      "database_id": "21fc83ee-78a4-49a6-a892-2500c788414c",
      "migrations_dir": "migrations"
    }
  ]
}
