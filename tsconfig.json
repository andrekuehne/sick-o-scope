// The Worker and code shared with the client. The client, tests and tooling
// have their own projects (src/client, test, tsconfig.node.json) that extend this one.
{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    // Node runs scripts/*.ts by stripping types, importing Worker code directly:
    // relative imports carry their .ts extension, and only erasable syntax is allowed.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/worker", "src/shared", "worker-configuration.d.ts"]
}
